{
    "manifest_version": 2,
    "name": "Workforce Mate",
    "version": "2.0.0",
    "description": "Fill out your job search efforts on the Workforce Australia website with ease",
    "permissions": [
        "https://*.workforceaustralia.gov.au/*",
        "https://*.seek.com.au/*",
        "https://*.seek.com/*",
        "https://*.jora.com/*",
        "https://*.linkedin.com/*"
    ],
    "background": {
        "scripts": [
            "sites.js",
            "background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.workforceaustralia.gov.au/*"
            ],
            "js": [
                "sites.js",
                "content.js"
            ]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}