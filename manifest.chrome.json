{
    "manifest_version": 3,
    "name": "Workforce Mate",
    "version": "3.0.0",
    "description": "Fill out your job search efforts on the Workforce Australia website with ease",
    "host_permissions": [
        "https://*.workforceaustralia.gov.au/*",
        "https://*.seek.com.au/*",
        "https://*.seek.com/*",
        "https://*.jora.com/*",
        "https://*.linkedin.com/*",
        "https://*.adzuna.com.au/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.workforceaustralia.gov.au/*"
            ],
            "js": [
                "sites.js",
                "content.js"
            ]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}